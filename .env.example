# Copy to .env and fill in. Never commit .env.
#
# Google Maps Platform key with the Maps JavaScript API enabled (3D maps use
# Photorealistic 3D Tiles through it). In Google Cloud Console, restrict it to
# HTTP referrers (your CloudFront/production domain and http://localhost:3000/*)
# and to the Maps JavaScript API only. The key ships to browsers by design;
# the restriction is what protects it.
VITE_GOOGLE_MAPS_API_KEY=
